# Copy to /etc/homelab-monitor/agent.env and chmod 600 - if you set
# HOMELAB_AGENT_TOKEN, this file holds that shared secret.
# All vars are optional - the agent runs fine with none set.

# AGENT_PORT=8080
# HOMELAB_SERVICES=jellyfin:8096,plex:32400

# Not used by the agent - user accounts/sessions live in the BACKEND's
# SQLite database (see backend.env.example's HOMELAB_DB_FILE). Left here
# commented so nobody goes looking for it on the agent side.
# HOMELAB_DB_FILE=data/homelab.db

# Restart commands per service, comma-separated name:command pairs. The name
# must match a HOMELAB_SERVICES entry; only the FIRST colon separates name
# from command, so commands containing colons are fine. Commands run on this
# machine with a 60s timeout when triggered from the dashboard - the agent
# only ever runs what is configured HERE, never a command from the network.
# HOMELAB_ACTIONS=jellyfin:systemctl restart jellyfin,plex:docker restart plex

# Requires every /stats request and every /restart request to carry a
# matching X-Homelab-Agent-Token header - the token gates the restart
# endpoint too, not just polling. Leave unset to accept unauthenticated
# requests (the default). Must match HOMELAB_AGENT_TOKEN in backend.env
# exactly - see README.md.
# HOMELAB_AGENT_TOKEN=
