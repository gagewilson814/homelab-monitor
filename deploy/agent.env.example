# Copy to /etc/homelab-monitor/agent.env and chmod 600 - if you set
# HOMELAB_AGENT_TOKEN, this file holds that shared secret.
# All vars are optional - the agent runs fine with none set.

# AGENT_PORT=8080
# HOMELAB_SERVICES=jellyfin:32400,plex:32401

# Requires every /stats request to carry a matching X-Homelab-Agent-Token
# header. Leave unset to accept unauthenticated requests (the default).
# Must match HOMELAB_AGENT_TOKEN in backend.env exactly - see README.md.
# HOMELAB_AGENT_TOKEN=
