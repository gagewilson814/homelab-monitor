[Unit]
Description=Homelab Monitor Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/homelab-monitor
ExecStart=/opt/homelab-monitor/homelab-backend
EnvironmentFile=/etc/homelab-monitor/backend.env
Restart=on-failure
RestartSec=5
User=homelab
Group=homelab
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
# The dashboard's agent list/tags persist to data/agents.json, resolved
# relative to WorkingDirectory - ProtectSystem=strict makes everything else
# read-only, so this is the one directory the backend can write to.
ReadWritePaths=/opt/homelab-monitor/data

[Install]
WantedBy=multi-user.target
